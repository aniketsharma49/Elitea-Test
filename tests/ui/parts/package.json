{
  "name": "inventree-parts-ui-tests",
  "version": "1.0.0",
  "description": "Playwright UI automation tests for the InvenTree Parts module",
  "scripts": {
    "test": "npx playwright test --config=playwright.config.ts",
    "test:smoke": "npx playwright test part_creation_workflow.spec.ts --config=playwright.config.ts",
    "test:menu": "npx playwright test part_creation_menu.spec.ts --config=playwright.config.ts",
    "test:form": "npx playwright test part_create_form_required_fields.spec.ts --config=playwright.config.ts",
    "test:headed": "npx playwright test --config=playwright.config.ts --headed",
    "report": "npx playwright show-report ../../../test-results/html-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
